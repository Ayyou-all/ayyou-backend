# ==============================================================================
# FICHIER D'EXEMPLE DE VARIABLES D'ENVIRONNEMENT — AYYOU PRODUCTION (VPS LWS)
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier vers .env sur votre serveur : cp .env.example .env
# 2. Remplissez chaque valeur avec vos paramètres réels et sécurisés
# 3. Ne commitez JAMAIS le fichier .env dans Git !
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SÉCURITÉ DJANGO CORE
# ------------------------------------------------------------------------------
# En production, AYYOU_DEBUG DOIT ÊTRE À False
AYYOU_DEBUG=False

# Générez une clé secrète aléatoire de 50+ caractères avec la commande :
# python -c "import secrets; print(secrets.token_urlsafe(50))"
AYYOU_CLE_SECRETE_DJANGO=remplacer_par_une_cle_secrete_aleatoire_de_50_caracteres_minimum

# Domaines autorisés à interroger Django (séparés par des virgules)
AYYOU_HOTES_AUTORISES=api.ayyou.site,ayyou.site,localhost,127.0.0.1,backend

# Origines Frontend autorisées pour le partage de ressources (CORS)
AYYOU_ORIGINES_FRONTEND=https://ayyou.site,http://localhost:2401,http://127.0.0.1:2401

# Origines fiables pour la protection CSRF Django en HTTPS
AYYOU_CSRF_ORIGINES=https://api.ayyou.site,https://ayyou.site,http://localhost:2401,http://127.0.0.1:2401,http://localhost:8888,http://127.0.0.1:8888

# URLs publiques pour la génération de liens (PayTech, notifications, emails)
AYYOU_URL_FRONTEND=https://ayyou.site
AYYOU_URL_PUBLIQUE_BACKEND=https://api.ayyou.site

# Niveau de journalisation console (DEBUG, INFO, WARNING, ERROR)
AYYOU_NIVEAU_JOURNAL=INFO

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES
# ------------------------------------------------------------------------------
# Moteur de base de données : 'sqlite' (par défaut) ou 'postgresql'
AYYOU_MOTEUR_BDD=sqlite

# Emplacement du fichier SQLite dans le volume persistant /app/data
AYYOU_BDD_FICHIER_SQLITE=data/db.sqlite3

# Paramètres PostgreSQL (utilisés uniquement si AYYOU_MOTEUR_BDD=postgresql)
AYYOU_BDD_NOM=ayyou
AYYOU_BDD_UTILISATEUR=ayyou
AYYOU_BDD_MOT_DE_PASSE=choisissez_un_mot_de_passe_robuste_pour_postgres
AYYOU_BDD_HOTE=base-de-donnees
AYYOU_BDD_PORT=5432

# ------------------------------------------------------------------------------
# 3. STOCKAGE MÉDIAS ET FICHIERS
# ------------------------------------------------------------------------------
AYYOU_DOSSIER_MEDIAS=medias
AYYOU_TAILLE_MAX_PHOTO_MO=8
AYYOU_TAILLE_MAX_VIDEO_MO=200

# ------------------------------------------------------------------------------
# 4. MICROSERVICE IA (FASTAPI)
# ------------------------------------------------------------------------------
# URL interne Docker : Django contacte FastAPI via le réseau interne ayyou-reseau
AYYOU_SERVICE_IA_URL=http://service-ia:8000
AYYOU_SERVICE_IA_CLE_INTERNE=cle-secrete-interne-ayyou-ia-2026
AYYOU_SERVICE_IA_DELAI_SECONDES=8

# Clé API optionnelle pour Gemini / OpenAI (si activée dans l'IA)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. PAIEMENT PAYTECH SÉNÉGAL (Orange Money, Wave, Free Money)
# ------------------------------------------------------------------------------
PAYTECH_URL_BASE=https://paytech.sn/api
PAYTECH_CLE_API=votre_cle_api_fournie_par_paytech
PAYTECH_CLE_SECRETE=votre_cle_secrete_fournie_par_paytech
# Environnement PayTech : 'test' pour tester en bac à sable, 'prod' pour les vrais paiements
PAYTECH_ENVIRONNEMENT=test
PAYTECH_DELAI_ATTENTE_SECONDES=15

# ------------------------------------------------------------------------------
# 6. CONFIGURATION E-MAILS (SMTP)
# ------------------------------------------------------------------------------
# Laissez vide pour utiliser la console Docker ou renseignez vos accès SMTP
AYYOU_EMAIL_HOST=smtp.gmail.com
AYYOU_EMAIL_PORT=587
AYYOU_EMAIL_USE_TLS=True
AYYOU_EMAIL_USE_SSL=False
AYYOU_EMAIL_HOST_USER=
AYYOU_EMAIL_HOST_PASSWORD=
AYYOU_DEFAULT_FROM_EMAIL=AYYOU <contact@ayyou.site>
