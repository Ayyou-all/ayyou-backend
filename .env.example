# Copier ce fichier en `.env` puis compléter. NE JAMAIS versionner `.env`.

# --- Django ---
AYYOU_DEBUG=true
AYYOU_CLE_SECRETE_DJANGO=remplacer-par-une-longue-chaine-aleatoire
AYYOU_HOTES_AUTORISES=localhost,127.0.0.1
AYYOU_ORIGINES_FRONTEND=http://localhost:4200
AYYOU_URL_FRONTEND=http://localhost:4200
# URL publique HTTPS du backend (obligatoire pour recevoir l'IPN PayTech, ex: tunnel ngrok)
AYYOU_URL_PUBLIQUE_BACKEND=http://localhost:8000

# --- Base de données ---
# sqlite (défaut) ou postgresql
# data/db.sqlite3 en conteneur Docker (volume persistant) ou db.sqlite3 en local
AYYOU_BDD_FICHIER_SQLITE=data/db.sqlite3
AYYOU_BDD_NOM=ayyou
AYYOU_BDD_UTILISATEUR=ayyou
AYYOU_BDD_MOT_DE_PASSE=
AYYOU_BDD_HOTE=localhost
AYYOU_BDD_PORT=5432

# --- Médias ---
AYYOU_DOSSIER_MEDIAS=medias
AYYOU_TAILLE_MAX_PHOTO_MO=8
AYYOU_TAILLE_MAX_VIDEO_MO=200

# --- Métier ---
AYYOU_FRAIS_LIVRAISON_DEFAUT_FCFA=1000

# --- E-mails SMTP (Envoi réel des codes de vérification) ---
AYYOU_EMAIL_HOST=smtp.gmail.com
AYYOU_EMAIL_PORT=587
AYYOU_EMAIL_USE_TLS=true
AYYOU_EMAIL_USE_SSL=false
AYYOU_EMAIL_HOST_USER=
AYYOU_EMAIL_HOST_PASSWORD=
AYYOU_DEFAULT_FROM_EMAIL=AYYOU <contact@ayyou.sn>

# --- PayTech (clés depuis le dashboard PayTech > Paramètres > API) ---
PAYTECH_URL_BASE=https://paytech.sn/api
PAYTECH_CLE_API=
PAYTECH_CLE_SECRETE=
PAYTECH_ENVIRONNEMENT=test
PAYTECH_DELAI_ATTENTE_SECONDES=15

# --- Service IA FastAPI ---
AYYOU_SERVICE_IA_URL=http://127.0.0.1:8001
# Même valeur que AYYOU_CLE_SECRETE_IA dans ayyou-ai/.env
AYYOU_SERVICE_IA_CLE_INTERNE=remplacer-par-une-cle-partagee
AYYOU_SERVICE_IA_DELAI_SECONDES=8

# --- Modèle économique (valeurs à confirmer par la direction) ---
# Part des frais de livraison reversée au livreur (%)
AYYOU_PART_LIVREUR_POURCENT=80
# Commission prélevée sur le montant des plats (%) ; 0 tant que ce n'est pas décidé
AYYOU_COMMISSION_RESTAURANT_POURCENT=0

# --- Délais métier (minutes) ---
AYYOU_DELAI_PAIEMENT_MINUTES=15
AYYOU_DELAI_ACCEPTATION_RESTAURANT_MINUTES=5
AYYOU_DELAI_ALERTE_SANS_LIVREUR_MINUTES=10
